# Провайдер LLM: anthropic | openai | gemini.
# Если не задан — берётся первый, для которого указан ключ. Без ключа работает ручной режим и пресеты.
LLM_PROVIDER=gemini
# Модель (необязательно). По умолчанию: gemini-3.5-flash-lite / claude-sonnet-5-5 / gpt-4o-mini.
# gemini-3.8-flash и gemini-3.6-flash на бесплатном тарифе при проверке 2026-11-07 зависали (таймаут), 3.5-flash-lite отвечал за ~1,5 с.
# Для фото нужна модель с поддержкой изображений.
LLM_MODEL=

# Бесплатный ключ Gemini: https://aistudio.google.com/apikey
# Внимание: на бесплатном тарифе Google использует содержимое запросов для улучшения своих продуктов.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# true -> если LLM недоступен, демо-пресеты берут результат из fixtures/*.json
DEMO_FALLBACK=true

# Лимит запросов к API с одного IP в минуту
RATE_LIMIT_PER_MIN=10
